# Copy to .env.local and fill in. See CMS-SETUP.md.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
# Secret — only needed for migration + writing leads. Editor-role token from sanity.io/manage.
SANITY_API_WRITE_TOKEN=

# Custom admin panel (/admin) — single shared credential, not a user database.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie (jose/JWT). Use a long random string.
ADMIN_SESSION_SECRET=
